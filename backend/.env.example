# ESGenius Backend — Environment Variables
# Copy this file to .env and fill in real values.
# Do NOT commit .env to version control.

DB_URL=jdbc:postgresql://localhost:5432/esgenius
DB_USERNAME=esgenius
DB_PASSWORD=your_password_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Parallel Gemini classifications per analysis process. Integer 1..8. 1 keeps classifications sequential.
GEMINI_MAX_CONCURRENCY=1
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
AUTH_REQUIRED=true
ADMIN_USER_IDS=
SUPABASE_TOKEN_CACHE_TTL=60s
ALLOWED_ORIGINS=http://localhost:8080
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
PDF_MAX_PAGES=400
PDF_MAX_EXTRACTED_CHARS=3000000
RATE_LIMIT_UPLOADS_PER_DAY=20
RATE_LIMIT_ANALYSES_PER_DAY=5
RATE_LIMIT_ASSISTANT_PER_HOUR=30
RATE_LIMIT_GLOBAL_ANALYSES_PER_DAY=20
